{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "methodology-process.schema.json",
  "title": "Governed methodology process",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_release_id", "heading", "lede", "scope_metrics", "layers", "phases", "decision_moments", "operating_model", "publication_policy", "practice_notes"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "analysis_release_id": {"type": "string"},
    "heading": {"type": "string"},
    "lede": {"type": "string"},
    "publication_policy": {"type": "string"},
    "scope_metrics": {"type": "array", "minItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["label", "value"], "properties": {"label": {"type": "string"}, "value": {"type": "string"}}}},
    "layers": {"type": "array", "minItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["layer_id", "display_order", "heading", "short_label", "input_summary", "decision_summary", "output_summary", "gate_summary", "path_type"], "properties": {"layer_id": {"type": "string"}, "display_order": {"type": "integer", "minimum": 1}, "heading": {"type": "string"}, "short_label": {"type": "string"}, "input_summary": {"type": "string"}, "decision_summary": {"type": "string"}, "output_summary": {"type": "string"}, "gate_summary": {"type": "string"}, "path_type": {"type": "string", "enum": ["analysis", "monitoring"]}}}},
    "phases": {"type": "array", "minItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["phase_id", "display_order", "heading", "objective", "work_completed", "decision_made", "rationale", "evidence_produced", "boundary_or_gate"], "properties": {"phase_id": {"type": "string"}, "display_order": {"type": "integer", "minimum": 1}, "heading": {"type": "string"}, "objective": {"type": "string"}, "work_completed": {"type": "string"}, "decision_made": {"type": "string"}, "rationale": {"type": "string"}, "evidence_produced": {"type": "string"}, "boundary_or_gate": {"type": "string"}}}},
    "decision_moments": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["decision_id", "display_order", "heading", "situation", "action_taken", "why_it_matters"], "properties": {"decision_id": {"type": "string"}, "display_order": {"type": "integer", "minimum": 1}, "heading": {"type": "string"}, "situation": {"type": "string"}, "action_taken": {"type": "string"}, "why_it_matters": {"type": "string"}}}},
    "operating_model": {"type": "object", "additionalProperties": false, "required": ["automated", "human"], "properties": {"automated": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/responsibility"}}, "human": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/responsibility"}}}},
    "practice_notes": {"type": "object", "additionalProperties": false, "required": ["ai_use", "access_limits", "next_week", "production_boundary"], "properties": {"ai_use": {"type": "string"}, "access_limits": {"type": "string"}, "next_week": {"type": "string"}, "production_boundary": {"type": "string"}}}
  },
  "$defs": {"responsibility": {"type": "object", "additionalProperties": false, "required": ["responsibility_id", "display_order", "owner_type", "responsibility"], "properties": {"responsibility_id": {"type": "string"}, "display_order": {"type": "integer", "minimum": 1}, "owner_type": {"type": "string", "enum": ["automated", "human"]}, "responsibility": {"type": "string"}}}}
}
