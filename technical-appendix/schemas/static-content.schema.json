{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "static-content.schema.json",
  "title": "Approved static site content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_release_id", "cutoff_exclusive", "approved_at", "surfaces", "source_manifest_sha256"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "analysis_release_id": {"type": "string"},
    "cutoff_exclusive": {"type": "string"},
    "approved_at": {"type": "string"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executive_overview", "thematic_analysis", "recommendations", "methodology", "data_reproducibility"],
      "properties": {
        "executive_overview": {"type": "object"},
        "thematic_analysis": {"type": "object"},
        "recommendations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["rank", "theme_id", "name", "posture", "recommendation", "confidence", "priority", "proposed_owner"],
            "properties": {
              "rank": {"type": "integer", "minimum": 1},
              "theme_id": {"type": "string"},
              "name": {"type": "string"},
              "posture": {"type": "string"},
              "recommendation": {"type": "string"},
              "confidence": {"type": "string"},
              "priority": {"type": "string"},
              "proposed_owner": {"type": "string"}
            }
          }
        },
        "methodology": {"type": "object"},
        "data_reproducibility": {"type": "object"}
      }
    }
  }
}
