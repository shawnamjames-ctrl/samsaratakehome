{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme-evidence.schema.json",
  "title": "Privacy-safe theme evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_release_id", "cutoff_exclusive", "evidence_policy", "total_theme_links", "unique_evidence_records", "themes"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "analysis_release_id": {"type": "string"},
    "cutoff_exclusive": {"type": "string"},
    "evidence_policy": {"type": "string"},
    "total_theme_links": {"type": "integer", "minimum": 1},
    "unique_evidence_records": {"type": "integer", "minimum": 1},
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme_id", "name", "rank", "evidence_count", "records"],
        "properties": {
          "theme_id": {"type": "string"},
          "name": {"type": "string"},
          "rank": {"type": "integer", "minimum": 1},
          "evidence_count": {"type": "integer", "minimum": 1},
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_key", "product", "platform", "time_band", "rating_band", "consequence", "workflow", "reported_experience"],
              "properties": {
                "evidence_key": {"type": "string", "pattern": "^ev_[a-p]{16}$"},
                "product": {"type": "string", "enum": ["Driver", "Fleet"]},
                "platform": {"type": "string", "enum": ["Android", "iOS"]},
                "time_band": {"type": "string"},
                "rating_band": {"type": "string"},
                "consequence": {"type": "string"},
                "workflow": {"type": "string"},
                "reported_experience": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
