{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "further-recommendations.schema.json",
  "title": "Approved further recommendations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_release_id", "publication_policy", "recommendation_count", "recommendations"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "analysis_release_id": {"type": "string"},
    "publication_policy": {"type": "string"},
    "recommendation_count": {"type": "integer", "minimum": 1},
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recommendation_id", "recommendation_name", "rationale", "evidence_status", "evidence_summary", "recommended_action", "decision_boundary", "additional_data_needed", "display_order", "evidence"],
        "properties": {
          "recommendation_id": {"type": "string"},
          "recommendation_name": {"type": "string"},
          "rationale": {"type": "string"},
          "evidence_status": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "label"],
            "properties": {
              "code": {"type": "string", "enum": ["supported_finding", "new_data_required", "supported_diagnostic"]},
              "label": {"type": "string"}
            }
          },
          "evidence_summary": {"type": "string"},
          "recommended_action": {"type": "string"},
          "decision_boundary": {"type": "string"},
          "additional_data_needed": {"type": "string"},
          "display_order": {"type": "integer", "minimum": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_id", "evidence_class", "metric_label", "metric_value", "context", "display_order"],
              "properties": {
                "evidence_id": {"type": "string"},
                "evidence_class": {"type": "string", "enum": ["governed_metric", "exploratory_probe", "collection_limitation"]},
                "metric_label": {"type": "string"},
                "metric_value": {"type": "string"},
                "context": {"type": "string"},
                "display_order": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
